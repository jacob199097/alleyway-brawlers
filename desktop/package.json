{
  "name": "alleyway-brawlers-desktop",
  "productName": "AlleyWay Brawlers",
  "version": "1.0.0",
  "description": "AlleyWay Brawlers — Electron desktop shell",
  "main": "main.js",
  "author": "AlleyWay Brawlers",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"npm --prefix ../client run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "start": "electron .",
    "build:client": "node check-server-url.js && npm --prefix ../client run build",
    "build": "npm run build:client && electron-builder --win",
    "build:dir": "npm run build:client && electron-builder --win dir"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  }
}
